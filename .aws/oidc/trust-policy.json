{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSpecificGitHubRepository",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::949502931402:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:Saiful-Rasel/single-server-3tier-webapp:ref:refs/heads/main"
        }
      }
    }
  ]
}
